<!-- View For DocuDoctor -->
<!-- Boring definitions for window -->
<Window x:Class="DocuDoctor.ViewController.MainWindow "
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:DocuDoctor.ViewController"
        mc:Ignorable="d"
        Title="DocuDoctor" 
        Height="450" Width="800" 
        Background="#313638" 
        Icon = "../assets/DocumentationDoctor.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- Disable the default top bar -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="15" CaptionHeight="0" />
    </WindowChrome.WindowChrome>
    <!-- Styling for the title bar buttons -->
    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bdr_main" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr_main" Property="Background" Value="#6c7a89" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr_main" Property="Background" Value="#6c7a89" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#333333"/>
            <!-- Dark gray background -->
            <Setter Property="BorderBrush" Value="#303030" />
            <!-- Black border -->
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- MenuItem Style -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <!-- White text -->
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>

            <!-- Highlight Effect -->
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#6c7a89"/>
                    <!-- Highlight color -->
                    <Setter Property="Foreground" Value="White"/>
                    <!-- Text color when highlighted -->
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!-- Border around the entire screen... without this when maximized windows cuts off 8px from all sides -->
    <Border BorderBrush="Green">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=WindowState}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="{Binding Source={x:Static SystemParameters.WindowResizeBorderThickness}}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Top bar buttons -->
            <Grid Grid.Row="0">
                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="/assets/DocumentationDoctor.png" Margin="20,0,0,0" VerticalAlignment="Center" Width="20" Height="20" />
                    <TextBlock Foreground="#f8f8ff" FontSize="18" Margin="20,0,20,0" VerticalAlignment="Center">DocuDoctor</TextBlock>
                    <Button Foreground="#f8f8ff" Style="{StaticResource TitleBarButtonStyle}" FontSize="18" Content="File" Width="75" Padding="5" Click="ProjectFileButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ProjectContextMenu">
                                <MenuItem Foreground="#f8f8ff" FontSize="18" Header="Load Project" Click="LoadProject_Click"/>
                                <MenuItem Foreground="#f8f8ff" FontSize="18" Header="Save Project" Click="SaveProject_Click"/>
                                <MenuItem Foreground="#f8f8ff" FontSize="18" Header="Save As" Click="SaveAs_Click"/>
                                <MenuItem Foreground="#f8f8ff" FontSize="18" Header="Export Project" Click="ExportProject_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="Minimize" Width="50" Background="Transparent" BorderBrush="Transparent" Click="buttonMinimize_Click">
                        <Image Source="../assets/minimize.png" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="Maximize" Width="50" Background="Transparent" BorderBrush="Transparent" Click="buttonMaximize_Click">
                        <Image x:Name="windowedButton" Source="../assets/windowed.png" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" x:Name="Close" Width="50" Background="Transparent" BorderBrush="Transparent" Click="buttonClose_Click">
                        <Image Source="../assets/close.png" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Method Parameters -->
                <Grid
                    Background="#313638"
                    Grid.Column="0"
                    >
                    <DataGrid Name="ParameterGrid" AutoGenerateColumns="True" VerticalAlignment="Top" MinHeight="750" MaxHeight="750"
                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,30,0,0" ColumnWidth="*">
                    </DataGrid>
                </Grid>
                <!-- Tool Bar -->
                <Grid
                    Background="#cfcfcf" 
                    Grid.Column="1"
                    >
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Button x:Name="Deselect" Width="40" Background="Transparent" BorderBrush="Transparent" Click="buttonDeselect_Click">
                            <Image Source="../assets/Deselect.png" Width="20" Height="35" />
                        </Button>
                        <Button x:Name="Delete" Width="40" Background="Transparent" BorderBrush="Transparent" Click="buttonDelete_Click">
                            <Image Source="../assets/EraseItem.png" Width="20" Height="35" />
                        </Button>
                        <Button x:Name="AddClass" Width="40" Background="Transparent" BorderBrush="Transparent" Click="buttonAddClass_Click">
                            <Image Source="../assets/AddClass.png" Width="20" Height="35" />
                        </Button>
                        <Button x:Name="AddInterface" Width="40" Background="Transparent" BorderBrush="Transparent" Click="buttonAddInterface_Click">
                            <Image Source="../assets/AddInterface.png" Width="20" Height="35" />
                        </Button>
                        <Button x:Name="AddTemplate" Width="40" Background="Transparent" BorderBrush="Transparent" Click="buttonAddTemplate_Click">
                            <Image Source="../assets/AddTemplate.png" Width="20" Height="35" />
                        </Button>
                        <Button x:Name="AddArrow" Width="40" Background="Transparent" BorderBrush="Transparent" Click="buttonAddArrow_Click">
                            <Image Source="../assets/arrow.png" Width="20" Height="35" />
                        </Button>
                        <Button x:Name="AddDottedArrow" Width="40" Background="Transparent" BorderBrush="Transparent" Click="buttonAddDottedArrow_Click">
                            <Image Source="../assets/dottedarrow.png" Width="20" Height="35" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>
                        <!-- Main Area -->
                        <Grid
                            Grid.Column="0"
                            Background="#313638" 
                            >
                            <skia:SKElement x:Name="skCanvas" PaintSurface="OnPaintSurface" />
                        </Grid>
                        <!-- Spacer Page -->
                        <Grid
                            Grid.Column="1"
                            Background="#303030" 
                            >
                        </Grid>
                        <!-- Properties Page -->
                        <Grid
                            Grid.Column="2"
                            Background="#313638" 
                            >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Property Text Element At Top -->
                            <Grid Grid.Row="0">
                                <TextBlock Foreground="#f8f8ff" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center">Properties</TextBlock>
                            </Grid>
                            <!-- Maleable Section Of Properties Page -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Foreground="#f8f8ff" Content="Name:" Grid.Column="0" VerticalAlignment="Center" />
                                    <TextBox Name="boxName" Grid.Row="0" Grid.Column="1" Width="200" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Foreground="#f8f8ff" Content="Properties:" VerticalAlignment="Top" />
                                    <DataGrid Name="PropertyGrid" AutoGenerateColumns="True" Height="200" VerticalAlignment="Top" 
                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,30,0,0" ColumnWidth="*">
                                    </DataGrid>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Label Foreground="#f8f8ff" Content="Methods:" VerticalAlignment="Top" />
                                    <DataGrid Name="MethodGrid" AutoGenerateColumns="True" Height="200" VerticalAlignment="Top" 
                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,30,0,0" ColumnWidth="*">
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                    <!-- Status Bar -->
                    <Grid
                        Grid.Row="1"
                        Background="#303030" 
                        >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width = "*" />
                            <ColumnDefinition Width = "140" />
                            <ColumnDefinition Width = "40" />
                            <ColumnDefinition Width = "140" />
                            <ColumnDefinition Width = "40" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#f8f8ff" Text ="With ❤️ From RCOS" HorizontalAlignment="Left" Margin="10" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock Name="RamUsageText" VerticalAlignment="Center" FontSize="14" Foreground="#f8f8ff" Text ="RAM Usage" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <ProgressBar Name="RamUsageBar" Height="20" Minimum="0" Maximum="100" Width="20" HorizontalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Column="3">
                            <TextBlock Name="CpuUsageText" VerticalAlignment="Center" FontSize="14" Foreground="#f8f8ff" Text ="CPU Usage" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Grid.Column="4">
                            <ProgressBar Name="CpuUsageBar" Height="20" Minimum="0" Maximum="100" Width="20" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
